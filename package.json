{
  "name": "clouds-generator",
  "version": "1.0.0",
  "private": true,
  "description": "Offline procedural cloud generator for Figma, inspired by Nephele",
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p tsconfig.main.json && tsc -p tsconfig.ui.json && tsc -p tsconfig.worker.json && tsc -p tsconfig.tests.json",
    "lint": "eslint code.ts src tests scripts eslint.config.js",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "test:responsiveness": "node tests/responsiveness.mjs",
    "test:preview-controls": "node tests/preview-controls.mjs && node tests/pointer-probe.mjs",
    "test:procedural": "node tests/procedural.mjs",
    "test:motion": "node tests/resize-motion.mjs",
    "test:flatten": "node tests/flatten-bottom.mjs && node tests/flatten-inheritance.mjs",
    "test:resize": "npm run build:all && node tests/resize-editor.mjs",
    "test:shape": "node tests/shape-editor.mjs",
    "test:update": "node tests/update-flow.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:render": "node tests/render-export.mjs",
    "test:e2e": "npm run build && npm run test:browser && npm run test:responsiveness && npm run test:preview-controls && npm run test:procedural && npm run test:shape && npm run test:resize && npm run test:motion && npm run test:flatten && npm run test:update && npm run test:render && npm run test:figui && npm run test:features && npm run test:shadow-mode && npm run test:insertion",
    "build:verify": "node scripts/verify-build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test:figui": "node scripts/check-figui.mjs",
    "test:features": "node tests/features.mjs",
    "build:check": "node scripts/verify-build.mjs --committed",
    "test:shadow-mode": "node tests/shadow-mode.mjs",
    "test:insertion": "node tests/insertion.mjs",
    "build:web": "node scripts/build-web.mjs",
    "build:all": "npm run build && npm run build:web",
    "test:web": "npm run build:web && node tests/web.mjs",
    "deploy:web": "npm run build:web && node scripts/publish-web.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@figma/eslint-plugin-figma-plugins": "^1.0.0",
    "@figma/plugin-typings": "^1.141.0",
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.29",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "6.0",
    "typescript-eslint": "^8.71.1"
  },
  "dependencies": {
    "@rogieking/figui3": "11.1.4"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
