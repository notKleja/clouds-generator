{"name":"clouds-generator","version":"1.0.0","private":true,"description":"Offline procedural cloud generator for Figma, inspired by Nephele","scripts":{"build":"node scripts/build.mjs","watch":"node scripts/build.mjs --watch","typecheck":"tsc --noEmit","lint":"eslint code.ts src tests --ext .ts","test":"node --import tsx --test tests/*.test.ts","test:browser":"node tests/browser.mjs","check":"npm run typecheck && npm run lint && npm test && npm run build","test:responsiveness":"node tests/responsiveness.mjs","test:preview-controls":"node tests/preview-controls.mjs && node tests/pointer-probe.mjs","test:procedural":"node tests/procedural.mjs"},"devDependencies":{"@eslint/js":"^9.39.4","@figma/eslint-plugin-figma-plugins":"^0.16.1","@figma/plugin-typings":"^1.117.0","@types/node":"^22.0.0","esbuild":"^0.25.0","eslint":"^9.39.4","playwright":"^1.56.0","tsx":"^4.20.0","typescript":"^5.9.3","typescript-eslint":"^8.57.1"},"dependencies":{"@rogieking/figui3":"11.1.4"}}